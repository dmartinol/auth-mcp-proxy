# Copy to secret-auth-mcp-proxy.yaml and apply out-of-band (do not commit real values).
# Apply namespace.yaml first so this namespace exists.
apiVersion: v1
kind: Secret
metadata:
  name: auth-mcp-proxy
  namespace: dmartino-insights-mcp-sso
  labels:
    app: auth-insights-mcp
type: Opaque
stringData:
  RED_HAT_SSO_CLIENT_ID: "insights-mcp-introspection"
  RED_HAT_SSO_CLIENT_SECRET: "REPLACE_ME"
