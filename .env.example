# Sidecar listener
LISTEN_HOST=0.0.0.0
LISTEN_PORT=8080

# MCP URLs (public = Route URL clients use; upstream = loopback insights-mcp)
MCP_PUBLIC_URL=https://insights-mcp-sso.example.com/mcp
MCP_UPSTREAM_URL=http://127.0.0.1:8080

# Red Hat SSO (resource server for introspection)
RED_HAT_SSO_ISSUER=https://sso.redhat.com/auth/realms/redhat-external
RED_HAT_SSO_CLIENT_ID=
RED_HAT_SSO_CLIENT_SECRET=

REQUIRED_SCOPES=api.console,api.ocm
CLIENT_REGISTRATION_MODE=pre_registered

# Dev only — never enable in production
# SKIP_JWT_VALIDATION=true

LOG_LEVEL=info
